{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tap Payments Authorize Refunds API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Refunds",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all refunds",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tap.company/v2/refunds"
          },
          "docs": "Lists refunds, filterable by charge and date."
        },
        {
          "info": {
            "name": "Create a refund",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tap.company/v2/refunds",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Issues a full or partial refund against a captured charge, referenced by charge_id."
        },
        {
          "info": {
            "name": "Retrieve a refund",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tap.company/v2/refunds/:refund_id",
            "params": [
              {
                "name": "refund_id",
                "value": "",
                "type": "path",
                "description": "The id of the refund."
              }
            ]
          },
          "docs": "Retrieves a refund by its id."
        }
      ]
    }
  ],
  "bundled": true
}